{
  "name": "freight-brokers",
  "version": "1.0.0",
  "description": "Freight broker invoice audit system",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node -r dotenv/config dist/index.js",
    "dev": "npm run build && npm start --",
    "test": "vitest run",
    "test:watch": "vitest",
    "pod:process": "npm run build && node -r dotenv/config dist/pod/cli.js",
    "db:migrate": "node -r dotenv/config scripts/migrate.cjs",
    "typecheck": "tsc --noEmit",
    "start:server": "node -r dotenv/config dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@supabase/supabase-js": "^2",
    "dotenv": "^16",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "ioredis": "^6.0.0",
    "stripe": "^22.6.1",
    "svix": "^2.3.0",
    "uuid": "^11.1.1",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^26",
    "typescript": "^7",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}

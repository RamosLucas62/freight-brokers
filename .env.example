# Node >=22. Never commit .env or expose backend keys in a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Private Cloudflare R2 bucket used for inbound invoice PDFs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=freight-audit-invoices

# Live providers; stub is only accepted by the CLI with --dry-run.
EXTRACTOR_PROVIDER=openrouter
CARRIER_PROVIDER=fmcsa
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_ALLOWED_MODELS=google/gemini-2.5-flash
OPENROUTER_DATA_PROCESSING_ACK=false
OPENROUTER_PDF_ENGINE=native
FMCSA_API_KEY=
FMCSA_BASE_URL=https://mobile.fmcsa.dot.gov/qc/services
CARRIER_CACHE_TTL_HOURS=4
LOW_CONFIDENCE_THRESHOLD=0.85

# Required account UUID for saved CLI audits, after migration 002.
# Synthetic test account: 00000000-0000-4000-8000-000000000001
AUDIT_TENANT_ID=

# EasyPanel / Resend inbound server (migration 003 required)
PORT=3000
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=reports@audit.aiolympian.com
# Enable only after migrations, credentials and receiving tests are ready.
WORKER_ENABLED=false

# Customer portal: exact public origin (HTTPS in production)
PORTAL_URL=https://portal.example.com
SUPABASE_ANON_KEY=

# Public Free Audit form, backend confirmation link, and paid-plan offer.
FREE_AUDIT_ORIGIN=https://aiolympian.com
FREE_AUDIT_ORIGINS=https://aiolympian.com,https://www.aiolympian.com
FREE_AUDIT_PUBLIC_URL=https://api.audit.aiolympian.com
FREE_AUDIT_OFFER_URL=https://aiolympian.com/pricing

# Shared security controls. The origin must accept traffic only from Cloudflare
# before TRUST_PROXY=cloudflare is enabled.
REDIS_URL=rediss://default:password@redis.example.com:6379
RATE_LIMIT_KEY_SECRET=
TRUST_PROXY=cloudflare
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
REQUIRE_MFA_SENSITIVE=true
PDF_SCAN_URL=http://pdf-scanner:8080
PDF_SCAN_TOKEN=
METRICS_TOKEN=
CSRF_SECRET=

# Stripe subscription checkout and webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CORE_MONTHLY=
STRIPE_PRICE_CORE_SEMIANNUAL=
STRIPE_PRICE_CORE_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_SEMIANNUAL=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_SEMIANNUAL=
STRIPE_PRICE_SCALE_ANNUAL=
STRIPE_RETENTION_COUPON_ID=
# Dedicated portal configuration: payment methods and invoice history enabled; subscription cancellation disabled.
STRIPE_PORTAL_CONFIGURATION_ID=

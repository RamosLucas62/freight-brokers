# Node 24.x. Never commit .env or expose backend keys in a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Private Cloudflare R2 bucket used for inbound invoice PDFs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=freight-audit-invoices

# Live providers; stub is only accepted by the CLI with --dry-run.
EXTRACTOR_PROVIDER=openrouter
CARRIER_PROVIDER=fmcsa
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_ALLOWED_MODELS=google/gemini-2.5-flash
OPENROUTER_DATA_PROCESSING_ACK=false
OPENROUTER_PDF_ENGINE=native
POD_OPENROUTER_MODEL=
POD_SECONDARY_OPENROUTER_MODEL=
RATE_CONFIRMATION_OPENROUTER_MODEL=
POD_CONFIDENCE_THRESHOLD=0.90
SUPPORTING_DOCUMENT_CONFIDENCE_THRESHOLD=0.90
FMCSA_API_KEY=
FMCSA_BASE_URL=https://mobile.fmcsa.dot.gov/qc/services
CARRIER_CACHE_TTL_HOURS=4
LOW_CONFIDENCE_THRESHOLD=0.85
CONFIDENCE_VERIFIED_THRESHOLD=0.92
CONFIDENCE_QA_SAMPLE_RATE=0.05

# Required account UUID for saved CLI audits, after migration 002.
# Synthetic test account: 00000000-0000-4000-8000-000000000001
AUDIT_TENANT_ID=

# EasyPanel / Resend inbound server (migration 003 required)
PORT=3000
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=reports@audit.aiolympian.com
# Google Chat lead and error notifications are required in the production
# server. Keep both secrets in the deployment environment; never commit them.
GOOGLE_CHAT_LEADS_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=...
GOOGLE_CHAT_ERRORS_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/.../messages?key=...&token=...
# Enable only after migrations, credentials and receiving tests are ready.
WORKER_ENABLED=false

# Rose Rocket Platform v2 discovery pilot (disabled without an authorized client).
# Webhook URL uses a long bearer token in the path because v2 does not document a
# signed delivery header. Redact this path in proxy/CDN logs before enabling.
ROSE_ROCKET_ENABLED=false
ROSE_ROCKET_CONNECT_ENABLED=false
# 32 random bytes encoded as base64url. Required only when customer setup is enabled.
ROSE_ROCKET_CREDENTIAL_KEY=
ROSE_ROCKET_ORG_ID=
ROSE_ROCKET_USER_ID=
ROSE_ROCKET_CLIENT_ID=
ROSE_ROCKET_CLIENT_SECRET=
ROSE_ROCKET_WEBHOOK_TOKEN=
# Optional API origin for a customer's Rose Rocket subdomain; must be HTTPS *.roserocket.com.
ROSE_ROCKET_API_ORIGIN=

# Customer portal: exact public origin (HTTPS in production)
PORTAL_URL=https://portal.example.com
SUPABASE_ANON_KEY=

# Public Free Audit form, backend confirmation link, and paid-plan offer.
FREE_AUDIT_ORIGIN=https://aiolympian.com
FREE_AUDIT_ORIGINS=https://aiolympian.com,https://www.aiolympian.com
FREE_AUDIT_PUBLIC_URL=https://api.audit.aiolympian.com
FREE_AUDIT_OFFER_URL=https://aiolympian.com/pricing

# Shared security controls. Use cloudflare only behind the Cloudflare proxy;
# use easypanel for a DNS-only domain routed through EasyPanel's Traefik proxy.
REDIS_URL=rediss://default:password@redis.example.com:6379
RATE_LIMIT_KEY_SECRET=
TRUST_PROXY=easypanel
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
REQUIRE_MFA_SENSITIVE=true
PDF_SCAN_URL=http://pdf-scanner:8080
PDF_SCAN_TOKEN=
METRICS_TOKEN=
CSRF_SECRET=

# Stripe subscription checkout and webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CORE_MONTHLY=
STRIPE_PRICE_CORE_SEMIANNUAL=
STRIPE_PRICE_CORE_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_SEMIANNUAL=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_SEMIANNUAL=
STRIPE_PRICE_SCALE_ANNUAL=
STRIPE_RETENTION_COUPON_ID=
# Dedicated portal configuration: payment methods and invoice history enabled; subscription cancellation disabled.
STRIPE_PORTAL_CONFIGURATION_ID=
